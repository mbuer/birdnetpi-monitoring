            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    100.0 * AVG(\n        CASE WHEN absolute_error < ABS(current_activity - actual_activity)\n             THEN 1.0 ELSE 0.0 END\n    ) FILTER (WHERE model = 'random_forest_v2_completed') AS \"RF Win Rate\",\n    100.0 * AVG(\n        CASE WHEN absolute_error < ABS(current_activity - actual_activity)\n             THEN 1.0 ELSE 0.0 END\n    ) FILTER (WHERE model = 'xgboost_v2_completed') AS \"XGB Win Rate\"\nFROM bird_activity_predictions\nWHERE actual_activity IS NOT NULL\n  AND model IN ('random_forest_v2_completed', 'xgboost_v2_completed');"
        }
      ],
