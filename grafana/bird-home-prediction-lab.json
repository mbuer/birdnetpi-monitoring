          "rawSql": "SELECT to_char(predicted_hour, 'YYYY-MM-DD HH24:MI') AS \"Forecast Hour\", model AS \"Model\", ROUND(predicted_activity::numeric, 1) AS \"Forecast\", ROUND(current_activity::numeric, 1) AS \"Persistence\", ROUND(actual_activity::numeric, 1) AS \"Actual\", ROUND(absolute_error::numeric, 1) AS \"ML Error\", CASE WHEN actual_activity IS NULL THEN NULL ELSE ROUND(ABS(current_activity - actual_activity)::numeric, 1) END AS \"Persistence Error\", CASE WHEN actual_activity IS NULL THEN 'PENDING' WHEN absolute_error < ABS(current_activity - actual_activity) THEN 'ML WIN' WHEN absolute_error > ABS(current_activity - actual_activity) THEN 'PERSISTENCE WIN' ELSE 'TIE' END AS \"Result\" FROM bird_activity_predictions ORDER BY predicted_hour DESC LIMIT 50;"
