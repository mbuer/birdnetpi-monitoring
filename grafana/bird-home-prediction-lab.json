            "type": "grafana-postgresql-datasource",
            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN COUNT(*) = 0 OR AVG(ABS(current_activity - actual_activity)) = 0 THEN NULL ELSE 100.0 * (AVG(ABS(current_activity - actual_activity)) - AVG(absolute_error)) / AVG(ABS(current_activity - actual_activity)) END AS \"Edge\" FROM bird_activity_predictions WHERE actual_activity IS NOT NULL;"
