    {
      "id": 5,
      "type": "stat",
      "title": "MODEL EDGE",
      "description": "Percentage improvement in MAE versus persistence. Positive is better.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
      },
      "gridPos": {
