    {
      "id": 4,
      "type": "stat",
      "title": "LIVE MODEL MAE",
      "description": "Mean absolute error of scored forward predictions. Lower is better.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
      },
      "gridPos": {
        "x": 10,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    AVG(absolute_error) FILTER (\n        WHERE model = 'random_forest_v2_completed'\n    ) AS \"RF MAE\",\n    AVG(absolute_error) FILTER (\n        WHERE model = 'xgboost_v2_completed'\n    ) AS \"XGB MAE\"\nFROM bird_activity_predictions\nWHERE actual_activity IS NOT NULL\n  AND model IN ('random_forest_v2_completed', 'xgboost_v2_completed');"
        }
