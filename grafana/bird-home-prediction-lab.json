    {
      "id": 14,
      "type": "table",
      "title": "Recent Predictions",
      "description": "Random Forest and XGBoost forward predictions, outcomes, and comparison against persistence",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_char(predicted_hour, 'YYYY-MM-DD HH24:MI') AS \"Forecast Hour\",\n  CASE\n    WHEN model = 'random_forest_v2_completed' THEN 'Random Forest'\n    WHEN model = 'xgboost_v2_completed' THEN 'XGBoost'\n    ELSE model\n  END AS \"Model\",\n  ROUND(predicted_activity::numeric, 1) AS \"Forecast\",\n  ROUND(current_activity::numeric, 1) AS \"Persistence\",\n  ROUND(actual_activity::numeric, 1) AS \"Actual\",\n  ROUND(absolute_error::numeric, 1) AS \"Model Error\",\n  CASE\n    WHEN actual_activity IS NULL THEN NULL\n    ELSE ROUND(ABS(current_activity - actual_activity)::numeric, 1)\n  END AS \"Persistence Error\",\n  CASE\n    WHEN actual_activity IS NULL THEN 'PENDING'\n    WHEN absolute_error < ABS(current_activity - actual_activity)\n      THEN 'MODEL WIN'\n    WHEN absolute_error > ABS(current_activity - actual_activity)\n      THEN 'PERSISTENCE WIN'\n    ELSE 'TIE'\n  END AS \"Result\"\nFROM bird_activity_predictions\nWHERE model IN ('random_forest_v2_completed', 'xgboost_v2_completed')\nORDER BY predicted_hour DESC, model\nLIMIT 50;"
        }
      ],
