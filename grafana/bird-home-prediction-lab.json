    {
      "id": 2,
      "type": "stat",
      "title": "NEXT HOUR FORECAST",
      "description": "Latest Random Forest and XGBoost forecasts for the same target hour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    MAX(predicted_activity) FILTER (\n        WHERE model = 'random_forest_v2_completed'\n    ) AS \"Random Forest\",\n    MAX(predicted_activity) FILTER (\n        WHERE model = 'xgboost_v2_completed'\n    ) AS \"XGBoost\"\nFROM bird_activity_predictions\nWHERE predicted_hour = (\n    SELECT MAX(predicted_hour)\n    FROM bird_activity_predictions\n    WHERE model IN ('random_forest_v2_completed', 'xgboost_v2_completed')\n);"
        }
      ],
