    {
      "id": 10,
      "type": "stat",
      "title": "MODEL WIN RATE",
      "description": "Percentage of scored hours where each model beats persistence",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
