    {
      "id": 5,
      "type": "stat",
      "title": "MODEL EDGE",
      "description": "Percentage MAE improvement versus persistence. Positive is better.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "afy5j1yt18b9cb"
      },
      "gridPos": {
        "x": 15,
        "y": 3,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "afy5j1yt18b9cb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    CASE\n        WHEN AVG(ABS(current_activity - actual_activity))\n             FILTER (WHERE model = 'random_forest_v2_completed') = 0\n        THEN NULL\n        ELSE 100.0 * (\n            AVG(ABS(current_activity - actual_activity))\n                FILTER (WHERE model = 'random_forest_v2_completed')\n            -\n            AVG(absolute_error)\n                FILTER (WHERE model = 'random_forest_v2_completed')\n        ) /\n        AVG(ABS(current_activity - actual_activity))\n            FILTER (WHERE model = 'random_forest_v2_completed')\n    END AS \"RF Edge\",\n    CASE\n        WHEN AVG(ABS(current_activity - actual_activity))\n             FILTER (WHERE model = 'xgboost_v2_completed') = 0\n        THEN NULL\n        ELSE 100.0 * (\n            AVG(ABS(current_activity - actual_activity))\n                FILTER (WHERE model = 'xgboost_v2_completed')\n            -\n            AVG(absolute_error)\n                FILTER (WHERE model = 'xgboost_v2_completed')\n        ) /\n        AVG(ABS(current_activity - actual_activity))\n            FILTER (WHERE model = 'xgboost_v2_completed')\n    END AS \"XGB Edge\"\nFROM bird_activity_predictions\nWHERE actual_activity IS NOT NULL\n  AND model IN ('random_forest_v2_completed', 'xgboost_v2_completed');"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percent",
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
