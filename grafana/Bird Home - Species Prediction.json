      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Prediction History — Head to Head",
          "description": "One row per target hour. Challenger columns populate when a challenger exists for the selected species.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afy5j1yt18b9cb"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH hourly AS (\n    SELECT\n        predicted_hour,\n        MAX(probability) FILTER (WHERE model = 'random_forest_species_v1') AS rf_probability,\n        MAX(probability) FILTER (WHERE model = 'xgboost_species_v1') AS xgb_probability,\n        MAX(probability) FILTER (WHERE model = 'xgboost_tuned_species_v1') AS tuned_probability,\n        MAX(probability) FILTER (WHERE model = 'xgboost_bootstrap_species_v1') AS bootstrap_probability,\n        MAX(predicted_present) FILTER (WHERE model = 'random_forest_species_v1') AS rf_prediction,\n        MAX(predicted_present) FILTER (WHERE model = 'xgboost_species_v1') AS xgb_prediction,\n        MAX(predicted_present) FILTER (WHERE model = 'xgboost_tuned_species_v1') AS tuned_prediction,\n        MAX(predicted_present) FILTER (WHERE model = 'xgboost_bootstrap_species_v1') AS bootstrap_prediction,\n        MAX(actual_present) AS actual_present\n    FROM bird_species_predictions\n    WHERE species = '$species'\n    GROUP BY predicted_hour\n)\nSELECT\n    to_char(predicted_hour, 'YYYY-MM-DD HH24:MI') AS \"Target Hour\",\n    ROUND((rf_probability * 100)::numeric, 1) AS \"RF %\",\n    ROUND((xgb_probability * 100)::numeric, 1) AS \"XGB %\",\n    ROUND((COALESCE(tuned_probability, bootstrap_probability) * 100)::numeric, 1) AS \"Challenger %\",\n    CASE\n        WHEN tuned_probability IS NOT NULL THEN 'Tuned XGBoost'\n        WHEN bootstrap_probability IS NOT NULL THEN 'Bootstrap XGBoost'\n        ELSE NULL\n    END AS \"Challenger\",\n    CASE actual_present\n        WHEN 1 THEN 'Present'\n        WHEN 0 THEN 'Absent'\n        ELSE 'Pending'\n    END AS \"Actual\",\n    CASE\n        WHEN actual_present IS NULL THEN 'Pending'\n        WHEN rf_prediction = actual_present THEN 'Yes'\n        ELSE 'No'\n    END AS \"RF Correct\",\n    CASE\n        WHEN actual_present IS NULL THEN 'Pending'\n        WHEN xgb_prediction = actual_present THEN 'Yes'\n        ELSE 'No'\n    END AS \"XGB Correct\",\n    CASE\n        WHEN actual_present IS NULL THEN 'Pending'\n        WHEN COALESCE(tuned_prediction, bootstrap_prediction) IS NULL THEN '—'\n        WHEN COALESCE(tuned_prediction, bootstrap_prediction) = actual_present THEN 'Yes'\n        ELSE 'No'\n    END AS \"Challenger Correct\"\nFROM hourly\nORDER BY predicted_hour DESC;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.1",
            "spec": {
              "options": {
                "cellHeight": "sm",
