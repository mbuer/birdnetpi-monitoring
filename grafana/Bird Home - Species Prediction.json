                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afy5j1yt18b9cb"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    CASE\n        WHEN model = 'random_forest_species_v1' THEN 'Random Forest'\n        WHEN model = 'xgboost_species_v1' THEN 'XGBoost'\n        ELSE model\n    END AS model,\n    100.0 * AVG(\n        CASE WHEN correct THEN 1.0 ELSE 0.0 END\n    ) AS accuracy\nFROM bird_species_predictions\nWHERE species = '$species'\n  AND scored_at IS NOT NULL\nGROUP BY model\nORDER BY model;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
