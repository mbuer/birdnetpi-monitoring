      "panel-6": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Live Model Metrics",
          "description": "Scored forward-validation metrics for the selected species/model/status.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afy5j1yt18b9cb"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH scored AS (\n    SELECT\n        model,\n        predicted_present,\n        actual_present,\n        correct\n    FROM bird_species_predictions\n    WHERE species = '$species'\n      AND scored_at IS NOT NULL\n      AND (\n  '$model' = '__all'\n  OR model = '$model'\n)\nAND (\n  '$status' = 'all'\n  OR ('$status' = 'baseline' AND model IN ('random_forest_species_v1','xgboost_species_v1'))\n  OR ('$status' = 'challenger' AND model NOT IN ('random_forest_species_v1','xgboost_species_v1'))\n)\n),\ncounts AS (\n    SELECT\n        model,\n        COUNT(*) AS scored,\n        COUNT(*) FILTER (WHERE predicted_present = 1 AND actual_present = 1) AS tp,\n        COUNT(*) FILTER (WHERE predicted_present = 1 AND actual_present = 0) AS fp,\n        COUNT(*) FILTER (WHERE predicted_present = 0 AND actual_present = 1) AS fn,\n        COUNT(*) FILTER (WHERE correct IS TRUE) AS correct\n    FROM scored\n    GROUP BY model\n)\nSELECT\n    CASE\n        WHEN model = 'random_forest_species_v1' THEN 'Random Forest'\n        WHEN model = 'xgboost_species_v1' THEN 'XGBoost'\n        WHEN model = 'xgboost_tuned_species_v1' THEN 'Tuned XGBoost'\n        WHEN model = 'xgboost_bootstrap_species_v1' THEN 'Bootstrap XGBoost'\n        ELSE model\n    END AS \"Model\",\n    scored AS \"Scored\",\n    ROUND(100.0 * correct / NULLIF(scored, 0), 1) AS \"Accuracy %\",\n    ROUND(100.0 * tp / NULLIF(tp + fp, 0), 1) AS \"Precision %\",\n    ROUND(100.0 * tp / NULLIF(tp + fn, 0), 1) AS \"Recall %\",\n    ROUND(100.0 * (2.0 * tp) / NULLIF((2.0 * tp) + fp + fn, 0), 1) AS \"F1 %\"\nFROM counts\nORDER BY \"Model\";"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.1",
