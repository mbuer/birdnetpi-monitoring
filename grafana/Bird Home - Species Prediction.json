      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Species Probability History",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afy5j1yt18b9cb"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    predicted_hour AT TIME ZONE 'America/Los_Angeles' AS time,\n    CASE\n        WHEN model = 'random_forest_species_v1' THEN 'Random Forest'\n        WHEN model = 'xgboost_species_v1' THEN 'XGBoost'\n        WHEN model = 'xgboost_tuned_species_v1' THEN 'Tuned XGBoost'\n        WHEN model = 'xgboost_bootstrap_species_v1' THEN 'Bootstrap XGBoost'\n        ELSE model\n    END AS metric,\n    probability * 100 AS value\nFROM bird_species_predictions\nWHERE species = '$species'\n  AND (\n  '$model' = '__all'\n  OR model = '$model'\n)\nAND (\n  '$status' = 'all'\n  OR ('$status' = 'baseline' AND model IN ('random_forest_species_v1','xgboost_species_v1'))\n  OR ('$status' = 'challenger' AND model NOT IN ('random_forest_species_v1','xgboost_species_v1'))\n)\n  AND $__timeFilter(predicted_hour AT TIME ZONE 'America/Los_Angeles')\nORDER BY time;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
