                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    predicted_hour AT TIME ZONE 'America/Los_Angeles' AS time,\n    CASE\n        WHEN model = 'random_forest_species_v1' THEN 'Random Forest'\n        WHEN model = 'xgboost_species_v1' THEN 'XGBoost'\n        ELSE model\n    END AS metric,\n    probability * 100 AS value\nFROM bird_species_predictions\nWHERE species = '$species'\n  AND $__timeFilter(predicted_hour AT TIME ZONE 'America/Los_Angeles')\nORDER BY time;"
