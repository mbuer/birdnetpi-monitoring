      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Prediction History",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "afy5j1yt18b9cb"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n    to_char(predicted_hour, 'YYYY-MM-DD HH24:MI') AS \"Target Hour\",\n    CASE\n        WHEN model = 'random_forest_species_v1' THEN 'Random Forest'\n        WHEN model = 'xgboost_species_v1' THEN 'XGBoost'\n        ELSE model\n    END AS \"Model\",\n    ROUND((probability * 100)::numeric, 1) AS \"Probability %\",\n    CASE predicted_present\n        WHEN 1 THEN 'Present'\n        ELSE 'Absent'\n    END AS \"Prediction\",\n    CASE actual_present\n        WHEN 1 THEN 'Present'\n        WHEN 0 THEN 'Absent'\n        ELSE 'Pending'\n    END AS \"Actual\",\n    CASE\n        WHEN correct IS TRUE THEN 'Yes'\n        WHEN correct IS FALSE THEN 'No'\n        ELSE 'Pending'\n    END AS \"Correct\",\n    training_rows AS \"Training Rows\"\nFROM bird_species_predictions\nWHERE species = '$species'\nORDER BY predicted_hour DESC, model;"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
