# /etc/systemd/system/birdnet-db-sync.service

[Unit]
Description=Sync BirdNET detections to PostgreSQL
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=birduser
EnvironmentFile=/home/birduser/.config/birdnet-monitoring/db.env
WorkingDirectory=/home/birduser/birdnetPi-monitoring
ExecStart=/usr/bin/python3 /home/birduser/birdnetPi-monitoring/collector/import_detections.py
TimeoutStartSec=30
