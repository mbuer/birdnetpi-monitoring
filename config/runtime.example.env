# BirdNET monitoring runtime configuration example.
# Copy to a local, ignored runtime file and replace example values.
# Never commit the real file.

# Station identity / location
BIRDNET_STATION_ID=birdnet
BIRDNET_TIMEZONE=Etc/UTC
BIRDNET_LATITUDE=0.0
BIRDNET_LONGITUDE=0.0

# PostgreSQL
BIRDNET_DB_HOST=INFRA_HOST
BIRDNET_DB_NAME=birdnet
BIRDNET_DB_USER=birdnet
BIRDNET_DB_PASSWORD=CHANGE_ME

# Loki
BIRDNET_LOKI_URL=http://INFRA_HOST:3100

# Optional source-path override. If omitted, collector defaults to
# ~/BirdNET-Pi/scripts/birds.db for the runtime user.
# BIRDNET_SQLITE_DB=/path/to/BirdNET-Pi/scripts/birds.db
